---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={"Home"} description={SITE_DESCRIPTION} />
	</head>
	<body class="flex flex-col">
		<Header />
		<main class="!my-0 flex-1 h-full flex items-center">
			<div>
				<h1 class="font-bold !text-[100px]">404</h1>
			<p class="text-muted">
				The page you're looking for doesn't exist or has been moved.
			</p>
			<div class="mt-8">
                <a href="/" class="py-2.5 px-6 bg-white text-black">Go Home</a>
                <a href="/blog" class="py-2.5 px-6 border border-border2 text-text">Blog</a>
			</div>
			</div>
		</main>
		<Footer />
	</body>
</html>
