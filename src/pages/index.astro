---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={"Home"} description={SITE_DESCRIPTION} />
	</head>
	<body class="flex flex-col">
		<Header />
		<main class="!my-0 flex-1 h-full flex items-center">
			<div>
				<h1 class="font-bold">Spoderx555</h1>
			<p class="text-muted">
				Just a security researcher who enjoys breaking things and writing about it. This is where I share my bug bounty findings and whatever I'm learning along the way.
			</p>
			<div class="mt-4">
				<a href="/blog" class="text-sm text-muted transition hover:text-white hover:border-b-border py-0.5 border-b border-b-border2 mr-2">Read the blog</a>
				<a href="https://twitter.com/spoderx555" class="text-sm text-muted transition hover:text-white hover:border-b-border py-0.5 border-b border-b-border2">Twitter / X</a>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>
