---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={"Home"} description={SITE_DESCRIPTION} />
	</head>
	<body class="flex flex-col">
		<Header />
		<main class="!my-0 flex-1 h-full text-center">
			<h1>Spoderx555</h1>
			<p>
				Just a security researcher who enjoys breaking things and writing about it. This is where I share my bug bounty findings and whatever I'm learning along the way.
			</p>
			<p>my <a class="underline" href="https://x.com/spoderx555">Twitter / X</a></p>
		</main>
		<Footer />
	</body>
</html>
